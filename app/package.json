{
  "name": "coderoster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "prebuild": "node scripts/copy-monaco.mjs",
    "predev": "node scripts/copy-monaco.mjs",
    "monaco:copy": "node scripts/copy-monaco.mjs",
    "check": "next lint && tsc --noEmit",
    "db:generate": "node scripts/run-prisma.mjs migrate dev",
    "db:migrate": "node scripts/run-prisma.mjs migrate deploy",
    "db:push": "node scripts/run-prisma.mjs db push",
    "db:studio": "node scripts/run-prisma.mjs studio",
    "db:seed": "tsx prisma/seed.ts",
    "outbox": "tsx src/server/outbox/dispatcher.ts",
    "consumer:execution": "tsx src/server/consumers/executionResult.ts",
    "job:snapshot": "tsx src/server/jobs/activitySnapshot.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f db",
    "dev": "next dev --turbo",
    "dev:docker": "npm run predev && next dev --hostname 0.0.0.0",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "node scripts/run-prisma.mjs generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
