# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# --- Postgres (local Docker) ---
# These drive `docker compose` and, when `DATABASE_URL` is unset, Prisma + Next
# (see `src/lib/databaseUrl.js` and `scripts/run-prisma.mjs`).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=coderoster
POSTGRES_PORT=5432
# Optional. Default: localhost. Use when the DB host is not localhost:5432.
# POSTGRES_HOST=localhost

# Prisma: https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Optional if POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB are set: same URL is
# derived for the app and `npm` Prisma scripts. Set explicitly to override (e.g.
# remote DB, SSL, or a URL that cannot be built from the vars above).
# DATABASE_URL=postgresql://postgres:password@localhost:5432/coderoster

# WorkOS
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=
# WORKOS_COOKIE_PASSWORD=
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# Session cookie lifetime in seconds. Default 30 days. AuthKit's own default
# is 10 minutes which logs learners out mid-lesson.
# WORKOS_COOKIE_MAX_AGE=2592000

# When `true`, server repositories return predefined fixtures instead of
# querying Prisma. Defaults to `false`. Recommended for local frontend
# development before the backend is wired up.
# USE_FAKE_DATA=true

# Docker Compose (`app` dev): optional override. Compose defaults a dev key so
# Server Action ids stay stable across `docker compose up` restarts; set your
# own if you share the stack. See `docker-compose.yml` (app service).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=