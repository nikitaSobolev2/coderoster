# Copy this file to `.env` and fill in real values.
# Used by `docker compose` and by every individual service.

# --- App build target ---
# `dev`  → npm run dev (Next.js dev server, HMR)
# `prod` → next build + production server
APP_ENV=dev

# --- Database (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coderoster
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/coderoster

# --- Redis ---
REDIS_URL=redis://redis:6379

# Optional: explicit secret for signing `livechat_guest` cookie (>= 16 chars).
# When unset, server derives key from WORKOS_COOKIE_PASSWORD.
#LIVECHAT_GUEST_SECRET=

# --- Plans & checkout ---
# When `false`, only admins may assign paid plans (see admin user / plan tools).
SELF_SERVE_PLANS=true
# Client-side mirror for marketing pages. Set `false` to hide self-serve upgrade CTAs.
NEXT_PUBLIC_SELF_SERVE_PLANS=true

# --- AI code improve (OpenAI-compatible API) ---
# Used by `code-improve-worker` (Go). Falls back to `OPENAI_API_KEY` if unset.
#AI_CODE_IMPROVE_API_KEY=
# Optional override (default OpenAI). Must be a valid URL if set.
#AI_CODE_IMPROVE_BASE_URL=https://api.openai.com/v1
# Circuit breaker: failures before opening + seconds to stay open (see workers/code-improve).
#AI_CODE_IMPROVE_CB_THRESHOLD=5
#AI_CODE_IMPROVE_CB_OPEN_SEC=120

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- WorkOS (AuthKit) ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Session cookie lifetime in seconds. Default 30 days. AuthKit's library
# default is 10 minutes which logs learners out mid-lesson.
WORKOS_COOKIE_MAX_AGE=2592000

# --- Feature flags ---
# When `true`, the app uses in-memory fixtures instead of Prisma/Redis/RabbitMQ.
USE_FAKE_DATA=false
# Mirror exposed to client components so demo links / sample CTAs can hide.
# Defaults to USE_FAKE_DATA in docker-compose.yml.
NEXT_PUBLIC_USE_FAKE_DATA=false

# --- Code execution sandbox ---
# Public images so first-time `docker compose up` works without a custom build.
# Swap to your own minimal images later if you want to lock down dependencies.
# `worker-code-exec` in docker-compose runs as 0:0 so it can open the host Docker socket (non-root default in image = permission denied on docker.sock).
WORKER_DOCKER_HOST=unix:///var/run/docker.sock
WORKER_PYTHON_IMAGE=python:3.12-slim
WORKER_PHP_IMAGE=php:8.3-cli-alpine
EXECUTION_TIMEOUT_MS=5000
# Docker image pull + stream drain (ms). Separate from EXECUTION_TIMEOUT_MS so
# cold pulls of e.g. WORKER_PHP_IMAGE are not cut off at the sandbox limit.
IMAGE_PULL_TIMEOUT_MS=900000
EXECUTION_MEMORY_MB=128
EXECUTION_CPUS=0.5
EXECUTION_PIDS_LIMIT=64

# --- Activity snapshot cron (UTC) ---
ACTIVITY_SNAPSHOT_CRON=30 0 * * *

# --- Object storage (MinIO / S3-compatible) ---
# `S3_ENDPOINT` is the internal endpoint used by the server (signs PUT URLs).
# `S3_PUBLIC_URL` is the host-visible base served back to the browser; it must
# be reachable from the user's machine (in dev: `http://localhost:9000/<bucket>`).
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000/coderoster-uploads
S3_REGION=us-east-1
S3_BUCKET=coderoster-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Hardening ---
SANITIZE_MARKDOWN=true
RATE_LIMIT_REDIS_PREFIX=rl:

# --- Admin bootstrap ---
# Email of the user that gets `role = ADMIN` on first WorkOS sync. Optional;
# clear once the bootstrap admin is promoted.
# ADMIN_BOOTSTRAP_EMAIL=
