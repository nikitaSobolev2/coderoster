# Copy this file to `.env` and fill in real values.
# Used by `docker compose` and by every individual service.

# --- App build target ---
# `dev`  → npm run dev (Next.js dev server, HMR)
# `prod` → next build + production server
APP_ENV=dev

# --- Database (Postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coderoster
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/coderoster

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- WorkOS (AuthKit) ---
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# --- Feature flags ---
# When `true`, the app uses in-memory fixtures instead of Prisma/Redis/RabbitMQ.
USE_FAKE_DATA=false

# --- Code execution sandbox ---
WORKER_DOCKER_HOST=unix:///var/run/docker.sock
WORKER_PYTHON_IMAGE=coderoster/sandbox-python:latest
WORKER_PHP_IMAGE=coderoster/sandbox-php:latest
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_MB=128
EXECUTION_CPUS=0.5
EXECUTION_PIDS_LIMIT=64

# --- Activity snapshot cron (UTC) ---
ACTIVITY_SNAPSHOT_CRON=30 0 * * *

# --- Hardening ---
SANITIZE_MARKDOWN=true
RATE_LIMIT_REDIS_PREFIX=rl:
